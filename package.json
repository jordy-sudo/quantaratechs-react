{
  "name": "quantaratechs-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server.js",
    "dev:full": "concurrently \"npm run api\" \"npm run dev\"",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir node_modules/.cache/quantara-ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "mail:verify": "node scripts/verify-mail.mjs"
  },
  "dependencies": {
    "@netlify/aws-lambda-compat": "^2.0.4",
    "@tailwindcss/vite": "^4.3.5",
    "compression": "^1.8.2",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "lucide-react": "^0.545.0",
    "nodemailer": "^10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serverless-http": "^4.0.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "vite": "^7.3.8",
    "concurrently": "^9.2.5"
  }
}
